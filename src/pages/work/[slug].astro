---
import type { GetStaticPaths } from "astro";
import { ArrowRightIcon } from "lucide-react";

import { DraftNotice } from "@/components/common/DraftNotice";
import { Container, Grid } from "@/components/layout/Container";
import { Section } from "@/components/layout/Section";
import { Media } from "@/components/media/Media";
import { CtaBand } from "@/components/sections/CtaBand";
import { PageHero } from "@/components/sections/PageHero";
import { QuoteBlock } from "@/components/sections/QuoteBlock";
import { SplitBlock } from "@/components/sections/SplitBlock";
import { StatList } from "@/components/sections/StatList";
import type { CaseStudy } from "@/data/types";
import { getSite, getWork, serviceLabel } from "@/lib/content";
import { whatsappLink } from "@/lib/site-links";
import { cn } from "@/lib/utils";
import PageLayout from "@/layouts/PageLayout.astro";

export const getStaticPaths = (() => {
  const work = getWork();
  return work.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      next: work.length > 1 ? work[(index + 1) % work.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  item: CaseStudy;
  next?: CaseStudy;
}

const { item, next } = Astro.props;
const site = getSite();
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: item.title, href: `/work/${item.slug}` },
];
const facts = [
  { label: "Client", value: item.client },
  { label: "Year", value: String(item.year) },
  { label: "Services", value: item.services.map(serviceLabel).join(", ") },
  { label: "Stack", value: item.stack.join(", ") },
];
---

<PageLayout title={item.title} description={item.summary}>
  <PageHero
    reviewId="WD-01"
    title={item.title}
    intro={item.summary}
    breadcrumbs={breadcrumbs}
    wide
  >
    <div slot="meta" class="flex flex-col gap-6">
      {item.draft && <DraftNotice label="Draft, visible in preview only" />}
      <p class="text-h4">{item.result}</p>
    </div>
    <dl class="mt-12 grid gap-x-(--col-gap) gap-y-6 border-t border-border pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((fact) => (
        <div class="flex flex-col gap-1">
          <dt class="text-caption text-muted-foreground">{fact.label}</dt>
          <dd class="text-sm font-medium">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </PageHero>

  <Section reviewId="WD-02" aria-label="Key numbers">
    <Container className="flex flex-col gap-16 md:gap-24">
      <Media
        ratio={item.cover.ratio}
        image={item.cover.image}
        priority
        className="reveal"
      />
      {item.metrics.length > 0 && <StatList stats={item.metrics} />}
    </Container>
  </Section>

  <Section spacing="none" className="pb-(--section-pad)">
    <Container className="flex flex-col gap-16 md:gap-20">
      <SplitBlock title="The problem" id="problem">
        <p>{item.problem}</p>
      </SplitBlock>
      <SplitBlock title="Our approach" id="approach">
        <p>{item.approach}</p>
      </SplitBlock>
    </Container>
  </Section>

  {item.screenshots.length > 0 && (
    <Section tone="deep" reviewId="WD-05" aria-label="Screenshots">
      <Container>
        <Grid className="gap-y-12">
          {item.screenshots.map((shot, index) => (
            <figure
              class={cn(
                "reveal col-span-full flex flex-col gap-4",
                shot.ratio === "9 / 16"
                  ? "md:col-span-4 lg:col-span-4"
                  : index === 0
                    ? "lg:col-span-12"
                    : "md:col-span-4 lg:col-span-8",
              )}
            >
              <Media ratio={shot.ratio} image={shot.image} />
              <figcaption class="text-caption text-muted-foreground">
                {shot.caption}
              </figcaption>
            </figure>
          ))}
        </Grid>
      </Container>
    </Section>
  )}

  <Section reviewId="WD-06" aria-label="Result">
    <Container className="flex flex-col gap-16 md:gap-20">
      <SplitBlock title="The result" id="result">
        <p>{item.outcome}</p>
      </SplitBlock>
      {item.quote && <QuoteBlock quote={item.quote} />}
      {next && (
        <a
          href={`/work/${next.slug}`}
          data-review-id="WD-08"
          class="group flex flex-col gap-3 border-t border-border pt-10"
        >
          <span class="text-caption text-muted-foreground">Next project</span>
          <span class="flex items-center justify-between gap-6 text-h2">
            {next.title}
            <ArrowRightIcon className="size-8 shrink-0 transition-transform duration-150 ease-out group-hover:translate-x-1" />
          </span>
        </a>
      )}
    </Container>
  </Section>

  <CtaBand
    tone="inverse"
    title="Planning something similar?"
    body="Tell us about your project. You get a straight answer on approach, cost and timeline after a free 30 minute call."
    action={site.cta}
    whatsapp={whatsappLink(site)}
    promise={site.promises.reply}
  />
</PageLayout>
