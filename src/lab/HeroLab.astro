---
import { HeroPreview } from "@/components/lab/HeroPreview";
import type { HeroVariant } from "@/components/sections/Hero";
import { hero } from "@/data/home";
import PageLayout from "@/layouts/PageLayout.astro";

interface Props {
  variant: HeroVariant;
  title: string;
}

const { variant, title } = Astro.props;
---

<PageLayout title={title} headerTone="deep" noindex>
  <HeroPreview
    client:only="react"
    variant={variant}
    headlines={hero.headlines}
    intro={hero.intro}
    action={hero.action}
    note={hero.note}
  />
</PageLayout>
